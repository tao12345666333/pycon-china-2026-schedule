{% macro talk_duration(talk) -%}
{{ talk.talk_minutes }} 分钟分享{% if talk.qa_minutes %} + {{ talk.qa_minutes }} 分钟 QA{% else %} · 无 QA{% endif %}
{%- endmacro %}

{% macro breakout_talk(talk) -%}
<article class="slot" id="{{ talk.id }}">
  <span class="time">{{ talk.start }}–{{ talk.end }}</span>
  <h4 class="talk-title">{{ talk.title }}</h4>
  <p class="talk-title-en" lang="en">{{ talk.title_en }}</p>
  <p class="speaker">{{ talk.speaker }}{% if talk.speaker_en != talk.speaker %} / {{ talk.speaker_en }}{% endif %} · {{ talk.role }}</p>
  <span class="duration">{{ talk_duration(talk) }}</span>
</article>
{%- endmacro %}

<!doctype html>
<html lang="zh-CN">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <meta name="description" content="{{ agenda.conference.name }} 双语议程">
  <link rel="icon" href="data:,">
  <link rel="stylesheet" href="./style.css?v=20260901">
  <title>{{ agenda.conference.name }} 议程</title>
</head>
<body>
  <header>
    <div class="wrap">
      <span class="eyebrow">{{ agenda.conference.status }}</span>
      <h1>{{ agenda.conference.name }}<br>双语议程</h1>
      <p class="subtitle">
        {{ agenda.conference.registration.title }} {{ agenda.conference.registration.start }}–{{ agenda.conference.registration.end }}；
        上午主会场 {{ schedule.morning_start }}–{{ schedule.morning_end }}，下午 {{ track_ids | length }} 个分会场
        {{ schedule.afternoon_start }}–{{ schedule.afternoon_end }}。{{ agenda.conference.tea_break.title }}
        {{ agenda.conference.tea_break.start }}–{{ agenda.conference.tea_break.end }}，闪电演讲最早于
        {{ schedule.lightning_start }} 开始。
      </p>
      <div class="meta">
        <span class="pill">{{ agenda.conference.theme }}</span>
        <span class="pill">{{ agenda.conference.date }} · {{ agenda.conference.timezone }}</span>
        <span class="pill">{{ agenda.talks | length }} 个议题</span>
        <span class="pill">{{ counts.standard }} 个标准演讲</span>
        <span class="pill">{{ counts.lightning }} 个闪电演讲</span>
        <span class="pill">{{ agenda.conference.start }}–{{ agenda.conference.end }}</span>
        <span class="pill">{{ agenda.conference.city }} · {{ agenda.conference.venue }}</span>
      </div>
    </div>
  </header>

  <main class="wrap">
    <div class="notice">
      <div class="notice-icon">◇</div>
      <div>
        <strong>可配置议程</strong>
        页面由 <code>data/agenda.yaml</code> 自动生成。通过 Pull Request 修改会议元数据、讲者、
        中英文标题、时段或分会场，合并到主分支后 GitHub Pages 会自动更新。
      </div>
    </div>

    <div class="section-head">
      <div><span class="eyebrow">Morning</span><h2>上午 · 主会场</h2></div>
      <p>{{ agenda.conference.registration.start }}–{{ agenda.conference.registration.end }}
        {{ agenda.conference.registration.title }}；随后连续安排 {{ morning | length }} 场主会场分享。</p>
    </div>

    <section class="main-stage" aria-label="上午主会场议程">
      <div class="stage-label">
        <span>{{ agenda.tracks.main.name }} · {{ agenda.tracks.main.name_en }} · {{ agenda.tracks.main.description }}</span>
        <span>{{ agenda.conference.registration.start }}–{{ agenda.conference.lunch.start }}</span>
      </div>
      <div class="slot break">
        <div class="time">{{ agenda.conference.registration.start }}–{{ agenda.conference.registration.end }}</div>
        <div>
          <p class="talk-title">{{ agenda.conference.registration.title }}</p>
          <p class="talk-title-en" lang="en">{{ agenda.conference.registration.title_en }}</p>
        </div>
        <span class="duration">{{ schedule.registration_minutes }} 分钟</span>
      </div>
      {% for talk in morning %}
      <article class="slot" id="{{ talk.id }}">
        <div class="time">{{ talk.start }}–{{ talk.end }}</div>
        <div>
          <h3 class="talk-title">{{ talk.title }}</h3>
          <p class="talk-title-en" lang="en">{{ talk.title_en }}</p>
          <p class="speaker">{{ talk.speaker }}{% if talk.speaker_en != talk.speaker %} / {{ talk.speaker_en }}{% endif %} · {{ talk.role }}</p>
        </div>
        <span class="duration">{{ talk_duration(talk) }}</span>
      </article>
      {% endfor %}
      <div class="slot break">
        <div class="time">{{ agenda.conference.lunch.start }}–{{ agenda.conference.lunch.end }}</div>
        <div>
          <p class="talk-title">{{ agenda.conference.lunch.title }}</p>
          <p class="talk-title-en" lang="en">{{ agenda.conference.lunch.title_en }}</p>
        </div>
        <span class="duration">{{ schedule.lunch_minutes }} 分钟</span>
      </div>
    </section>

    <div class="section-head">
      <div><span class="eyebrow">Afternoon</span><h2>下午 · {{ track_ids | length }} 个分会场</h2></div>
      <p>{{ schedule.afternoon_start }} 开始，{{ agenda.conference.tea_break.start }}–{{ agenda.conference.tea_break.end }}
        统一{{ agenda.conference.tea_break.title }}；{{ schedule.lightning_tracks | join("、") }} 会场于
        {{ schedule.lightning_start }} 起安排闪电演讲。</p>
    </div>

    <div class="tracks">
      {% for track_id in track_ids %}
      {% set track = agenda.tracks[track_id] %}
      <section class="track track-{{ track_id | lower }}" aria-label="{{ track.name }}">
        <div class="track-head">
          <h3>{{ track_id }} · {{ track.name }}</h3>
          <p class="track-name-en" lang="en">{{ track.name_en }}</p>
          <p>{{ track.description }}</p>
        </div>
        {% for talk in breakouts[track_id].standard_before_break %}
        {{ breakout_talk(talk) }}
        {% endfor %}
        <div class="slot break">
          <span class="time">{{ agenda.conference.tea_break.start }}–{{ agenda.conference.tea_break.end }}</span>
          <p class="talk-title">{{ agenda.conference.tea_break.title }} · {{ schedule.tea_break_minutes }} 分钟</p>
          <p class="talk-title-en" lang="en">{{ agenda.conference.tea_break.title_en }}</p>
        </div>
        {% for talk in breakouts[track_id].standard_after_break %}
        {{ breakout_talk(talk) }}
        {% endfor %}
        {% if breakouts[track_id].lightning %}
        <div class="slot lightning-block">
          <span class="time">{{ breakouts[track_id].lightning[0].start }}–{{ breakouts[track_id].lightning[-1].end }} · 闪电演讲</span>
          <div class="lightning-list">
            {% for talk in breakouts[track_id].lightning %}
            <article class="lightning-item" id="{{ talk.id }}">
              <h4 class="talk-title">{{ talk.start }}–{{ talk.end }} · {{ talk.title }}</h4>
              <p class="talk-title-en" lang="en">{{ talk.title_en }}</p>
              <p class="speaker">{{ talk.speaker }}{% if talk.speaker_en != talk.speaker %} / {{ talk.speaker_en }}{% endif %} · {{ talk.role }}</p>
              <span class="duration">{{ talk_duration(talk) }}</span>
            </article>
            {% endfor %}
          </div>
        </div>
        {% endif %}
      </section>
      {% endfor %}
    </div>

    <aside class="notes">
      <h3>议程说明</h3>
      <ul>
        <li>会议日程为 {{ agenda.conference.start }}–{{ agenda.conference.end }}，时区为 {{ agenda.conference.timezone }}。</li>
        <li>上午主会场为 {{ schedule.morning_start }}–{{ schedule.morning_end }}，共 {{ morning | length }} 场分享。</li>
        <li>{{ agenda.conference.lunch.title }}为 {{ agenda.conference.lunch.start }}–{{ agenda.conference.lunch.end }}。</li>
        <li>{{ agenda.conference.tea_break.title }}统一为 {{ agenda.conference.tea_break.start }}–{{ agenda.conference.tea_break.end }}，
          共 {{ schedule.tea_break_minutes }} 分钟；{{ schedule.lightning_tracks | join("、") }} 会场安排闪电演讲。</li>
      </ul>
    </aside>
  </main>

  <footer>
    <div class="wrap">{{ agenda.conference.name }} · 页面由 YAML 自动生成</div>
  </footer>
</body>
</html>
